#!/usr/bin/env python3
"""Launcher that works installed (.deb) or straight from a source checkout."""
import os
import sys

here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(here, "codenotch")):
    sys.path.insert(0, here)

from codenotch.__main__ import main

if __name__ == "__main__":
    raise SystemExit(main())
