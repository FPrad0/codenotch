#!/usr/bin/env python3
"""codenotch-hook: what Claude Code's hooks call. Reports the event plus the hook's stdin JSON to
the running Codenotch, launching it first if it is not up. Never blocks Claude Code: ~2 s budget,
and every failure exits 0 quietly."""
import json
import os
import shutil
import socket
import subprocess
import sys
import time

DEFAULT_PORT = 48666
MAX_STDIN = 256 * 1024


def read_port():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "codenotch", "config.json"), encoding="utf-8") as f:
            return int(json.load(f).get("port") or DEFAULT_PORT)
    except (OSError, ValueError, TypeError, AttributeError):
        return DEFAULT_PORT


def send(port, event, ppid, body):
    data = body.encode("utf-8", errors="replace")
    head = (f"POST /event?e={event}&ppid={ppid} HTTP/1.1\r\nHost: 127.0.0.1\r\n"
            f"Content-Type: application/json\r\nContent-Length: {len(data)}\r\nConnection: close\r\n\r\n")
    with socket.create_connection(("127.0.0.1", port), timeout=0.3) as s:
        s.settimeout(0.7)
        s.sendall(head.encode("ascii") + data)
        s.shutdown(socket.SHUT_WR)
        try:
            for _ in range(8):  # drain the short reply, so closing never resets the connection
                if not s.recv(512):
                    break
        except OSError:
            pass


def spawn_main():
    exe = shutil.which("codenotch")
    if not exe:
        sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "codenotch")
        exe = sibling if os.path.isfile(sibling) else None
    if not exe:
        return
    try:
        subprocess.Popen([exe], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError:
        pass


def main():
    event = sys.argv[1] if len(sys.argv) > 1 else "ping"
    event = "".join(c for c in event if c.isalnum() or c == "_")[:32] or "ping"
    try:
        body = sys.stdin.read(MAX_STDIN) if not sys.stdin.isatty() else ""
    except (OSError, ValueError):
        body = ""
    port = read_port()
    ppid = os.getppid()
    try:
        send(port, event, ppid, body)
        return
    except OSError:
        pass
    spawn_main()
    for _ in range(20):
        time.sleep(0.1)
        try:
            send(port, event, ppid, body)
            return
        except OSError:
            continue


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
